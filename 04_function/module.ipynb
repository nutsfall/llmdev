    "import urllib.request\n",
    "\n",
    "# URLを指定してデータを取得\n",
    "url = \"https://techacademy.jp\"\n",
    "response = urllib.request.urlopen(url)\n",
    "\n",
    "# HTMLデータを読み込み、UTF-8文字列にデコード\n",
    "html = response.read().decode(\"utf-8\")\n",
    "print(html[:500])  # 取得したHTMLの先頭500文字を表示"
   ]
